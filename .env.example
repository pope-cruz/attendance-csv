# Copy to .env.local and fill once you create the Supabase project
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY...
NEXT_PUBLIC_SUPABASE_OPERATOR_EMAIL=organizers@example.com

# Optional — only if you add server-side writes with service role (keep secret, never NEXT_PUBLIC)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE...
